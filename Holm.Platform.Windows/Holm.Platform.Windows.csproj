<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows backend: Win32, COM and WinRT behind the interfaces of Holm.Platform. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Power source changes, without a window of our own to receive them. -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.0" />
    <!-- DPAPI for the friends key, as the app keeps it. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Holm.Platform\Holm.Platform.csproj" />
    <ProjectReference Include="..\Holm.Core\Holm.Core.csproj" />
  </ItemGroup>

</Project>
