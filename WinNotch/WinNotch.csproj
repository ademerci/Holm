<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Holm</AssemblyName>
    <RootNamespace>WinNotch</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Holm</Product>
    <Version>1.7.3</Version>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>

    <!-- Keep the idle footprint small: no background GC thread, no PGO instrumentation. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <!-- Run the precompiled (ReadyToRun) code as it is instead of compiling timer code again in the background:
         measured idle, that halves the CPU and saves the 3–5 MB steps every time a method gets recompiled. -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('notch.ico')">
    <ApplicationIcon>notch.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The WinRT projection is huge and we only touch a few types of it; precompiling it would bloat the exe. -->
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll" />
    <EmbeddedResource Include="Assets\incoming-file.wav" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.7.0" />
  </ItemGroup>

</Project>
