<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Holm</AssemblyName>
    <RootNamespace>WinNotch</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Holm</Product>
    <Version>1.9.2</Version>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
    <!-- No compression in the single exe: a compressed bundle unpacks every assembly it loads into private memory.
         Measured idle on Windows (tools/Measure-Footprint.ps1): 148 MB private and a 256 MB peak compressed, 42 MB
         and 130 MB without, and a third less CPU at start-up. The exe grows from 86 to 219 MB on disk; the release zip
         only from 79.6 to 80.9 MB. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <!-- Keep the idle footprint small: no background GC thread, no PGO instrumentation. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <!-- Run the precompiled (ReadyToRun) code as it is instead of compiling timer code again in the background:
         measured idle, that halves the CPU and saves the 3–5 MB steps every time a method gets recompiled. -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <!-- A GIPHY API key for GIF search, built into the app but never into the public source: from -p:GiphyKey=…, the
       GIPHY_API_KEY environment variable (the release workflow's secret) or a giphy.key file next to the solution
       (git ignores it). Without one, people add their own key in the GIF picker. -->
  <PropertyGroup>
    <GiphyKey Condition="'$(GiphyKey)' == ''">$(GIPHY_API_KEY)</GiphyKey>
    <GiphyKey Condition="'$(GiphyKey)' == '' and Exists('$(MSBuildProjectDirectory)\..\giphy.key')">$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\giphy.key').Trim())</GiphyKey>
  </PropertyGroup>
  <ItemGroup Condition="'$(GiphyKey)' != ''">
    <AssemblyMetadata Include="GiphyKey" Value="$(GiphyKey)" />
  </ItemGroup>

  <PropertyGroup Condition="Exists('notch.ico')">
    <ApplicationIcon>notch.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The WinRT projection is huge and we only touch a few types of it; precompiling it would bloat the exe. -->
    <PublishReadyToRunExclude Include="Microsoft.Windows.SDK.NET.dll" />
    <EmbeddedResource Include="Assets\incoming-file.wav" />
    <Resource Include="notch.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.7.0" />
    <!-- Color emoji in the chat (WPF draws emoji in black and white); it uses Windows' own Segoe UI Emoji. -->
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
  </ItemGroup>

</Project>
