<Window x:Class="WinNotch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Holm" Width="480" Height="250" Left="0" Top="0"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="White"
        TextOptions.TextRenderingMode="Grayscale">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="Dim" Color="#A6FFFFFF"/>
        <SolidColorBrush x:Key="Faint" Color="#66FFFFFF"/>
        <SolidColorBrush x:Key="ArtFallback" Color="#FF262628"/>
        <SolidColorBrush x:Key="BadgeFallback" Color="#FF5B5FC7"/>

        <Geometry x:Key="PlayGeo">M3,1 L16,9 L3,17 Z</Geometry>
        <Geometry x:Key="PauseGeo">M3,1 L7,1 L7,17 L3,17 Z M11,1 L15,1 L15,17 L11,17 Z</Geometry>
        <Geometry x:Key="NextGeo">M1,2 L9,9 L1,16 Z M9,2 L17,9 L9,16 Z</Geometry>
        <Geometry x:Key="PrevGeo">M17,2 L9,9 L17,16 Z M9,2 L1,9 L9,16 Z</Geometry>

        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Fill" Value="White"/>
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>

        <Style x:Key="NotchButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="22">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter TargetName="Cp" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.86" ScaleY="0.86"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Cp" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Unread count, like the badge on a phone's app icon -->
        <Style x:Key="CountPill" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BadgeFallback}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="MinWidth" Value="16"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CountText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Accept / Decline / Cancel in the notch -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2EFFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="13" Height="26" Padding="12,0" MinWidth="54">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cp" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A person (or "send with code") to drop files on -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="19" Padding="4,4,14,4">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A whole row you can click (the messages in the open notch) -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#14FFFFFF" CornerRadius="14" Padding="10,8,12,8">
                            <ContentPresenter x:Name="Cp" RenderTransformOrigin="0.5,0.5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter TargetName="Cp" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid x:Name="IslandHost" HorizontalAlignment="Center" VerticalAlignment="Top">

            <!-- One backdrop for the notch and its concave "shoulders", so the cover colours flow into both.
                 It reaches 10px past the notch on each side; UpdateShape cuts the outline out of it. -->
            <Grid x:Name="Backdrop" Margin="-10,0,-10,0">
                <Rectangle Fill="Black"/>
                <Border x:Name="ArtLayerA" Opacity="0">
                    <Border Background="Black" Opacity="0.5"/>
                </Border>
                <Border x:Name="ArtLayerB" Opacity="0">
                    <Border Background="Black" Opacity="0.5"/>
                </Border>
            </Grid>

            <Border x:Name="Island" Background="Transparent" Width="150" Height="30" VerticalAlignment="Top"
                    MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
                    MouseLeftButtonUp="Island_MouseLeftButtonUp" ContextMenuOpening="Island_ContextMenuOpening"
                    AllowDrop="True" DragEnter="Island_DragEnter" DragOver="Island_DragOver" DragLeave="Island_DragLeave" Drop="Island_Drop">
                <Border.ContextMenu>
                    <ContextMenu Closed="Menu_Closed">
                        <MenuItem x:Name="MenuAnim" Header="Animate equalizer" IsCheckable="True" Click="MenuAnim_Click"/>
                        <MenuItem x:Name="MenuMini" Header="Minimize when idle" IsCheckable="True" Click="MenuMini_Click"/>
                        <MenuItem x:Name="MenuAutostart" Header="Start with Windows" IsCheckable="True" Click="MenuAutostart_Click"/>
                        <Separator/>
                        <!-- Claude / Gemini / ChatGPT / your app are filled in when the menu opens -->
                        <MenuItem x:Name="MenuAi" Header="AI button"/>
                        <!-- Show messages, then one switch per app; filled in when the menu opens -->
                        <MenuItem x:Name="MenuMessages" Header="Messages"/>
                        <MenuItem x:Name="MenuDownloads" Header="Downloads" IsCheckable="True" Click="MenuDownloads_Click"/>
                        <MenuItem x:Name="MenuVpn" Header="VPN indicator" IsCheckable="True" Click="MenuVpn_Click"/>
                        <MenuItem x:Name="MenuBeam" Header="Beam (drop files on the notch)" IsCheckable="True" Click="MenuBeam_Click"/>
                        <MenuItem x:Name="MenuReceive" Header="Receive with copied code" Click="MenuReceive_Click"/>
                        <!-- Copy my friend code / Add friend from clipboard / Remove friend, filled when the menu opens -->
                        <MenuItem x:Name="MenuFriends" Header="Friends"/>
                        <MenuItem x:Name="MenuCollapsedSize" Header="Collapsed size"/>
                        <MenuItem x:Name="MenuExpandedSize" Header="Expanded size"/>
                        <MenuItem x:Name="MenuUpdates" Header="Updates">
                            <MenuItem x:Name="MenuUpdateStatus" IsEnabled="False"/>
                            <Separator/>
                            <MenuItem x:Name="MenuAutoUpdates" Header="Check automatically" IsCheckable="True"
                                      StaysOpenOnClick="True" Click="MenuAutoUpdates_Click"/>
                            <MenuItem x:Name="MenuCheckUpdates" Header="Check for updates" StaysOpenOnClick="True"
                                      Click="MenuCheckUpdates_Click"/>
                            <MenuItem x:Name="MenuInstallUpdate" Header="Update and restart" Visibility="Collapsed"
                                      Click="MenuInstallUpdate_Click"/>
                        </MenuItem>
                        <Separator x:Name="MonitorSeparator"/>
                        <!-- one entry per display is inserted here when the menu opens -->
                        <Separator/>
                        <MenuItem Header="Quit" Click="MenuExit_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid x:Name="IslandContent">

                    <!-- Compact: something is playing -->
                    <Grid x:Name="CompactView" Opacity="0" IsHitTestVisible="False" Margin="9,0,12,0">
                        <Border x:Name="CompactArt" Width="20" Height="20" CornerRadius="5"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource ArtFallback}"/>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <StackPanel x:Name="MediaBadgeLogos" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Border x:Name="MediaBadge" Style="{StaticResource CountPill}" Margin="0,0,9,0" Visibility="Collapsed">
                                <TextBlock x:Name="MediaBadgeText" Style="{StaticResource CountText}"/>
                            </Border>
                            <StackPanel x:Name="EqPanel" VerticalAlignment="Center" Orientation="Horizontal" Height="14">
                                <Rectangle x:Name="Bar1" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1,0" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0.45"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle x:Name="Bar2" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1,0" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0.85"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle x:Name="Bar3" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1,0" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0.6"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle x:Name="Bar4" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1,0" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0.75"/></Rectangle.RenderTransform>
                                </Rectangle>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Idle: nothing going on; a small lock while a VPN is connected -->
                    <Grid x:Name="IdleView" Opacity="0" IsHitTestVisible="False" Margin="0,0,14,0">
                        <TextBlock x:Name="IdleLock" Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                   Foreground="{StaticResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>

                    <!-- Badge: nothing playing, unread messages -->
                    <Grid x:Name="BadgeView" Opacity="0" IsHitTestVisible="False" Margin="10,0">
                        <StackPanel x:Name="BadgeLogoList" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Border x:Name="BadgePill" Style="{StaticResource CountPill}" HorizontalAlignment="Right">
                            <TextBlock x:Name="BadgeText" Style="{StaticResource CountText}"/>
                        </Border>
                    </Grid>

                    <!-- Message: a message just came in (WhatsApp, Discord, Outlook, ...) -->
                    <Grid x:Name="MessageView" Opacity="0" IsHitTestVisible="False" Margin="14,0,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="MessageLogoHost" Width="28" Height="28" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="MessageTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="MessageText" FontSize="12" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Peek: short notification (headphones connected, charging, ...) -->
                    <Grid x:Name="PeekView" Opacity="0" IsHitTestVisible="False" Margin="16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock x:Name="PeekIcon" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="PeekText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock x:Name="PeekValue" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <!-- Custom controls are inserted from code: XAML that references local types
                                 needs a second compiler pass, which `dotnet publish -r` silently skips. -->
                            <Border x:Name="PeekBatteryHost" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Volume: the system volume just changed -->
                    <Grid x:Name="VolumeView" Opacity="0" IsHitTestVisible="False" Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="VolPeekIcon" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center"/>
                        <Border x:Name="VolPeekHost" Grid.Column="1" Margin="12,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="VolPeekText" Grid.Column="2" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Download: a browser is saving a file to Downloads -->
                    <Grid x:Name="DownloadView" Opacity="0" IsHitTestVisible="False" Margin="15,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#FF0A84FF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DownloadName" Grid.Column="1" Margin="10,0,10,0" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DownloadSize" Grid.Column="2" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Share: files are being dragged over the notch -->
                    <StackPanel x:Name="ShareView" Opacity="0" IsHitTestVisible="False" Width="364"
                                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0">
                        <TextBlock x:Name="ShareTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ShareHint" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        <WrapPanel x:Name="ShareTargets" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- Task: a Beam offer to answer, a code waiting for a friend, a transfer in progress -->
                    <Grid x:Name="TaskView" Opacity="0" IsHitTestVisible="False" Margin="12,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="TaskIconCircle" Width="34" Height="34" CornerRadius="17" Background="#FF0A84FF" VerticalAlignment="Center">
                            <TextBlock x:Name="TaskIcon" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TaskTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TaskSubtitle" FontSize="12" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            <Border x:Name="TaskProgressHost" Margin="0,4,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="TaskSecondary" Style="{StaticResource PillButton}" Click="TaskSecondary_Click"/>
                            <Button x:Name="TaskPrimary" Style="{StaticResource PillButton}" Background="#FF0A84FF" Margin="6,0,0,0" Click="TaskPrimary_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Expanded: hover -->
                    <Grid x:Name="ExpandedView" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed"
                          Width="400" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0">
                        <StackPanel>

                            <StackPanel x:Name="MediaPanel">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Clicking the cover or the title brings the player to the front -->
                                    <Border x:Name="BigArt" Width="58" Height="58" CornerRadius="12" Background="{StaticResource ArtFallback}"
                                            Cursor="Hand" ToolTip="Open the player" MouseLeftButtonUp="Player_Click">
                                        <TextBlock x:Name="ArtPlaceholder" Text="&#xEC4F;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                                   Foreground="{StaticResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Background="Transparent"
                                                Cursor="Hand" MouseLeftButtonUp="Player_Click">
                                        <TextBlock x:Name="TitleText" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="15"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="ArtistText" FontSize="13" Foreground="{StaticResource Dim}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                        <TextBlock x:Name="AppText" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="ProgressRow" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="42"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PosText" FontSize="11" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                                    <Border x:Name="ProgressHost" Grid.Column="1" Margin="4,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="RemainText" Grid.Column="2" FontSize="11" Foreground="{StaticResource Dim}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                    <Button x:Name="ShuffleBtn" Style="{StaticResource NotchButton}" Width="34" Height="34" Margin="0,0,14,0"
                                            Click="Shuffle_Click" ToolTip="Shuffle">
                                        <TextBlock x:Name="ShuffleIcon" Text="&#xE8B1;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                                    </Button>
                                    <Button x:Name="PrevBtn" Style="{StaticResource NotchButton}" Width="42" Height="42" Click="Prev_Click">
                                        <Path Data="{StaticResource PrevGeo}" Style="{StaticResource IconPath}" Width="21" Height="15"/>
                                    </Button>
                                    <Button x:Name="PlayBtn" Style="{StaticResource NotchButton}" Width="46" Height="46" Margin="16,0" Click="Play_Click">
                                        <Path x:Name="PlayIcon" Data="{StaticResource PlayGeo}" Style="{StaticResource IconPath}" Width="18" Height="20"/>
                                    </Button>
                                    <Button x:Name="NextBtn" Style="{StaticResource NotchButton}" Width="42" Height="42" Click="Next_Click">
                                        <Path Data="{StaticResource NextGeo}" Style="{StaticResource IconPath}" Width="21" Height="15"/>
                                    </Button>
                                    <Button x:Name="RepeatBtn" Style="{StaticResource NotchButton}" Width="34" Height="34" Margin="14,0,0,0"
                                            Click="Repeat_Click" ToolTip="Repeat">
                                        <TextBlock x:Name="RepeatIcon" Text="&#xE8EE;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="ClockPanel" Visibility="Collapsed" Margin="2,0,0,0">
                                <TextBlock x:Name="ClockBig" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="40"
                                           FontWeight="Light" Margin="0,-6,0,0"/>
                                <TextBlock x:Name="DateText" FontSize="13" Foreground="{StaticResource Dim}" Margin="1,0,0,0"/>
                                <TextBlock Text="Nothing playing" FontSize="11" Foreground="{StaticResource Faint}" Margin="1,6,0,0"/>
                            </StackPanel>

                            <StackPanel x:Name="MessageRows" Margin="0,14,0,0"/>

                            <!-- Downloads running right now -->
                            <Grid x:Name="DownloadRow" Margin="2,12,2,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#FF0A84FF" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DownloadRowName" Grid.Column="1" Margin="10,0,10,0" FontSize="12" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DownloadRowSize" Grid.Column="2" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Height="1" Background="#1AFFFFFF" Margin="0,12,0,8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="DevicesPanel" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Where the sound goes: a list of the speakers and headphones to switch to -->
                                    <Button x:Name="OutputBtn" Style="{StaticResource NotchButton}" Width="30" Height="30" Margin="0,0,2,0"
                                            Visibility="Collapsed" Click="Output_Click">
                                        <TextBlock x:Name="OutputIcon" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   Foreground="{StaticResource Dim}" Text="&#xE7F5;"/>
                                    </Button>
                                    <Button x:Name="MuteBtn" Style="{StaticResource NotchButton}" Width="30" Height="30" Click="Mute_Click">
                                        <TextBlock x:Name="VolIcon" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   Foreground="{StaticResource Dim}" Text="&#xE995;"/>
                                    </Button>
                                    <Border x:Name="VolumeHost" Width="84" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                    <!-- Opens Claude, Gemini, ChatGPT or your own pick (right-click › AI button) -->
                                    <Button x:Name="AiBtn" Style="{StaticResource NotchButton}" Width="30" Height="30" Margin="6,0,0,0"
                                            Visibility="Collapsed" Click="Ai_Click">
                                        <Border x:Name="AiIconHost" Width="18" Height="18"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
