<Window x:Class="WinNotch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Holm" Width="560" Height="250" Left="0" Top="0"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="White"
        TextOptions.TextRenderingMode="Grayscale">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="Dim" Color="#A6FFFFFF"/>
        <SolidColorBrush x:Key="Faint" Color="#66FFFFFF"/>
        <SolidColorBrush x:Key="ArtFallback" Color="#FF262628"/>
        <SolidColorBrush x:Key="BadgeFallback" Color="#FF5B5FC7"/>

        <Geometry x:Key="PlayGeo">M3,1 L16,9 L3,17 Z</Geometry>
        <Geometry x:Key="PauseGeo">M3,1 L7,1 L7,17 L3,17 Z M11,1 L15,1 L15,17 L11,17 Z</Geometry>
        <Geometry x:Key="NextGeo">M1,2 L9,9 L1,16 Z M9,2 L17,9 L9,16 Z</Geometry>
        <Geometry x:Key="PrevGeo">M17,2 L9,9 L17,16 Z M9,2 L1,9 L9,16 Z</Geometry>

        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Fill" Value="White"/>
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stretch" Value="Uniform"/>
        </Style>

        <Style x:Key="NotchButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="22">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter TargetName="Cp" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.86" ScaleY="0.86"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Cp" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Unread count, like the badge on a phone's app icon -->
        <Style x:Key="CountPill" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BadgeFallback}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="MinWidth" Value="16"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CountText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Accept / Decline / Cancel in the notch -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2EFFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="13" Height="26" Padding="12,0" MinWidth="54">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Cp" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A person (or "send with code") to drop files on -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="19" Padding="4,4,14,4">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Typing in the open notch: notes, reminders, the calculator -->
        <Style x:Key="NotchTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#FF0A84FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="12" Padding="10,7">
                            <ScrollViewer x:Name="PART_ContentHost" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#990A84FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A tool in the open notch's tool bar; lit while its page is open -->
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource NotchButton}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="3,0"/>
        </Style>

        <!-- A whole row you can click (the messages in the open notch) -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#14FFFFFF" CornerRadius="14" Padding="10,8,12,8">
                            <ContentPresenter x:Name="Cp" RenderTransformOrigin="0.5,0.5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter TargetName="Cp" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid x:Name="IslandHost" HorizontalAlignment="Center" VerticalAlignment="Top">

            <!-- One backdrop for the notch and its concave "shoulders", so the cover colours flow into both.
                 It reaches 10px past the notch on each side; UpdateShape cuts the outline out of it. -->
            <Grid x:Name="Backdrop" Margin="-10,0,-10,0">
                <Rectangle Fill="Black"/>
                <Border x:Name="ArtLayerA" Opacity="0">
                    <Border Background="Black" Opacity="0.5"/>
                </Border>
                <Border x:Name="ArtLayerB" Opacity="0">
                    <Border Background="Black" Opacity="0.5"/>
                </Border>
            </Grid>

            <Border x:Name="Island" Background="Transparent" Width="150" Height="30" VerticalAlignment="Top"
                    MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
                    MouseLeftButtonUp="Island_MouseLeftButtonUp" ContextMenuOpening="Island_ContextMenuOpening"
                    AllowDrop="True" DragEnter="Island_DragEnter" DragOver="Island_DragOver" DragLeave="Island_DragLeave" Drop="Island_Drop">
                <Border.ContextMenu>
                    <ContextMenu Closed="Menu_Closed">
                        <MenuItem x:Name="MenuAnim" Header="Animate equalizer" IsCheckable="True" Click="MenuAnim_Click"/>
                        <MenuItem x:Name="MenuMini" Header="Minimize when idle" IsCheckable="True" Click="MenuMini_Click"/>
                        <MenuItem x:Name="MenuAutostart" Header="Start with Windows" IsCheckable="True" Click="MenuAutostart_Click"/>
                        <Separator/>
                        <!-- 5 minutes … 1 hour, or pause / more time / stop while one runs; filled when the menu opens -->
                        <MenuItem x:Name="MenuTimer" Header="Timer"/>
                        <!-- 15 minutes / 30 minutes / 1 hour / Off, and the moon button; filled when the menu opens -->
                        <MenuItem x:Name="MenuSleep" Header="Sleep timer"/>
                        <MenuItem x:Name="MenuNotes" Header="Notes" IsCheckable="True" Click="MenuNotes_Click"/>
                        <MenuItem x:Name="MenuReminders" Header="Reminders" IsCheckable="True" Click="MenuReminders_Click"/>
                        <MenuItem x:Name="MenuCalculator" Header="Calculator" IsCheckable="True" Click="MenuCalculator_Click"/>
                        <MenuItem x:Name="MenuClipboardHistory" Header="Clipboard history" IsCheckable="True" Click="MenuClipboardHistory_Click"/>
                        <MenuItem x:Name="MenuClearPasswords" Header="Clear copied passwords after 30 s" IsCheckable="True" Click="MenuClearPasswords_Click"/>
                        <MenuItem x:Name="MenuColorPicker" Header="Color picker" IsCheckable="True" Click="MenuColorPicker_Click"/>
                        <MenuItem x:Name="MenuCapsLock" Header="Caps Lock hint" IsCheckable="True" Click="MenuCapsLock_Click"/>
                        <MenuItem x:Name="MenuDiskWarning" Header="Low disk space warning" IsCheckable="True" Click="MenuDiskWarning_Click"/>
                        <!-- Claude / Gemini / ChatGPT / your app are filled in when the menu opens -->
                        <MenuItem x:Name="MenuAi" Header="AI button"/>
                        <!-- Show messages, then one switch per app; filled in when the menu opens -->
                        <MenuItem x:Name="MenuMessages" Header="Messages"/>
                        <!-- On, from, until, and the apps and people that still pop out; filled when the menu opens -->
                        <MenuItem x:Name="MenuQuiet" Header="Quiet hours"/>
                        <MenuItem x:Name="MenuDownloads" Header="Downloads" IsCheckable="True" Click="MenuDownloads_Click"/>
                        <MenuItem x:Name="MenuVpn" Header="VPN indicator" IsCheckable="True" Click="MenuVpn_Click"/>
                        <MenuItem x:Name="MenuPrivacy" Header="Microphone and camera dot" IsCheckable="True" Click="MenuPrivacy_Click"/>
                        <MenuItem x:Name="MenuCalls" Header="Calls" IsCheckable="True" Click="MenuCalls_Click"/>
                        <MenuItem x:Name="MenuPauseForCalls" Header="Pause music during calls" IsCheckable="True" Click="MenuPauseForCalls_Click"/>
                        <MenuItem x:Name="MenuScreenshots" Header="Screenshots" IsCheckable="True" Click="MenuScreenshots_Click"/>
                        <MenuItem x:Name="MenuScreenshotText" Header="Copy text from screenshots" IsCheckable="True" Click="MenuScreenshotText_Click"/>
                        <MenuItem x:Name="MenuBeam" Header="Beam (drop files on the notch)" IsCheckable="True" Click="MenuBeam_Click"/>
                        <MenuItem x:Name="MenuReceive" Header="Receive with copied code" Click="MenuReceive_Click"/>
                        <!-- Copy my friend code / Add friend from clipboard / Remove friend, filled when the menu opens -->
                        <MenuItem x:Name="MenuFriends" Header="Friends"/>
                        <MenuItem x:Name="MenuCollapsedSize" Header="Collapsed size"/>
                        <MenuItem x:Name="MenuExpandedSize" Header="Expanded size"/>
                        <MenuItem x:Name="MenuUpdates">
                            <MenuItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="MenuUpdatesLabel" Text="Updates" VerticalAlignment="Center"/>
                                    <Border x:Name="MenuUpdateIcon" Width="19" Height="19" CornerRadius="9.5"
                                            Background="#FF0A84FF" Margin="7,0,0,0" Visibility="Collapsed">
                                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </MenuItem.Header>
                            <MenuItem x:Name="MenuUpdateStatus" IsEnabled="False"/>
                            <Separator/>
                            <MenuItem x:Name="MenuAutoUpdates" Header="Check automatically" IsCheckable="True"
                                      StaysOpenOnClick="True" Click="MenuAutoUpdates_Click"/>
                            <MenuItem x:Name="MenuCheckUpdates" Header="Check for updates" StaysOpenOnClick="True"
                                      Click="MenuCheckUpdates_Click"/>
                            <MenuItem x:Name="MenuInstallUpdate" Header="Update and restart" Visibility="Collapsed"
                                      Click="MenuInstallUpdate_Click"/>
                        </MenuItem>
                        <Separator x:Name="MonitorSeparator"/>
                        <!-- one entry per display is inserted here when the menu opens -->
                        <Separator/>
                        <MenuItem Header="Quit" Click="MenuExit_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid x:Name="IslandContent">

                    <!-- Compact: something is playing -->
                    <Grid x:Name="CompactView" Opacity="0" IsHitTestVisible="False" Margin="9,0,12,0">
                        <Border x:Name="CompactArt" Width="20" Height="20" CornerRadius="5"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource ArtFallback}"/>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <StackPanel x:Name="MediaBadgeLogos" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Border x:Name="MediaBadge" Style="{StaticResource CountPill}" Margin="0,0,9,0" Visibility="Collapsed">
                                <TextBlock x:Name="MediaBadgeText" Style="{StaticResource CountText}"/>
                            </Border>
                            <!-- A running timer takes the equalizer's place -->
                            <TextBlock x:Name="CompactTimer" FontSize="13" FontWeight="SemiBold" Foreground="#FFFF9F0A"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                            <StackPanel x:Name="EqPanel" VerticalAlignment="Center" Orientation="Horizontal" Height="14">
                                <Rectangle x:Name="Bar1" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1,0" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0.45"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle x:Name="Bar2" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1,0" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0.85"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle x:Name="Bar3" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1,0" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0.6"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle x:Name="Bar4" Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1,0" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform><ScaleTransform ScaleY="0.75"/></Rectangle.RenderTransform>
                                </Rectangle>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Idle: nothing going on; a small lock while a VPN is connected -->
                    <Grid x:Name="IdleView" Opacity="0" IsHitTestVisible="False" Margin="0,0,14,0">
                        <!-- Something on the shelf: how many -->
                        <StackPanel x:Name="IdleShelf" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="14,0,0,0" Visibility="Collapsed">
                            <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="IdleShelfCount" FontSize="10" Foreground="{StaticResource Dim}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="IdleLock" Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                   Foreground="{StaticResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>

                    <!-- Call: Discord, Teams, Zoom, WhatsApp or a browser uses the microphone -->
                    <Grid x:Name="CallView" Opacity="0" IsHitTestVisible="False" Margin="9,0,14,0">
                        <Border x:Name="CallLogoHost" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="CallMutedIcon" Text="&#xEC54;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="#FFFF453A" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="CallTime" FontSize="13" FontWeight="SemiBold" Foreground="#FF30D158" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Timer: a timer runs and nothing plays -->
                    <Grid x:Name="TimerView" Opacity="0" IsHitTestVisible="False" Margin="14,0">
                        <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#FFFF9F0A"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TimerText" FontSize="14" FontWeight="SemiBold" Foreground="#FFFF9F0A"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Badge: nothing playing, unread messages -->
                    <Grid x:Name="BadgeView" Opacity="0" IsHitTestVisible="False" Margin="10,0">
                        <StackPanel x:Name="BadgeLogoList" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Border x:Name="BadgePill" Style="{StaticResource CountPill}" HorizontalAlignment="Right">
                            <TextBlock x:Name="BadgeText" Style="{StaticResource CountText}"/>
                        </Border>
                    </Grid>

                    <!-- Message: a message just came in (WhatsApp, Discord, Outlook, ...) -->
                    <Grid x:Name="MessageView" Opacity="0" IsHitTestVisible="False" Margin="14,0,18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="MessageLogoHost" Width="28" Height="28" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="MessageTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="MessageText" FontSize="12" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Peek: short notification (headphones connected, charging, ...) -->
                    <Grid x:Name="PeekView" Opacity="0" IsHitTestVisible="False" Margin="16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock x:Name="PeekIcon" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="PeekText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock x:Name="PeekValue" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <!-- Custom controls are inserted from code: XAML that references local types
                                 needs a second compiler pass, which `dotnet publish -r` silently skips. -->
                            <Border x:Name="PeekBatteryHost" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Volume: the system volume just changed -->
                    <Grid x:Name="VolumeView" Opacity="0" IsHitTestVisible="False" Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="VolPeekIcon" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center"/>
                        <Border x:Name="VolPeekHost" Grid.Column="1" Margin="12,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="VolPeekText" Grid.Column="2" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Download: a browser is saving a file to Downloads -->
                    <Grid x:Name="DownloadView" Opacity="0" IsHitTestVisible="False" Margin="15,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#FF0A84FF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DownloadName" Grid.Column="1" Margin="10,0,10,0" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock x:Name="DownloadSize" Grid.Column="2" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Share: files are being dragged over the notch -->
                    <StackPanel x:Name="ShareView" Opacity="0" IsHitTestVisible="False" Width="364"
                                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0">
                        <TextBlock x:Name="ShareTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ShareHint" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        <WrapPanel x:Name="ShareTargets" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- Phone: a QR code for the phone's camera, while the files wait for it -->
                    <Grid x:Name="PhoneView" Opacity="0" IsHitTestVisible="False" Margin="16,14,16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="PhoneQrHost" Width="132" Height="132" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Scan with your phone's camera" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PhoneSubtitle" FontSize="12" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                            <TextBlock x:Name="PhoneStatus" FontSize="12" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource PillButton}" Background="#FF0A84FF" Content="Done" Click="PhoneDone_Click"/>
                                <Button Style="{StaticResource PillButton}" Content="Copy link" Margin="6,0,0,0" Click="PhoneCopy_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Task: a Beam offer to answer, a code waiting for a friend, a transfer in progress -->
                    <Grid x:Name="TaskView" Opacity="0" IsHitTestVisible="False" Margin="12,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- A screenshot shows itself here instead of the icon; click to open it -->
                        <Border x:Name="TaskThumb" Width="54" Height="36" CornerRadius="6" VerticalAlignment="Center" Visibility="Collapsed"
                                Cursor="Hand" ToolTip="Open" MouseLeftButtonUp="TaskThumb_Click"/>
                        <Border x:Name="TaskIconCircle" Width="34" Height="34" CornerRadius="17" Background="#FF0A84FF" VerticalAlignment="Center">
                            <TextBlock x:Name="TaskIcon" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TaskTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TaskSubtitle" FontSize="12" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            <Border x:Name="TaskProgressHost" Margin="0,4,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="TaskExtra" Style="{StaticResource PillButton}" Margin="0,0,6,0" Visibility="Collapsed" Click="TaskExtra_Click"/>
                            <Button x:Name="TaskSecondary" Style="{StaticResource PillButton}" Click="TaskSecondary_Click"/>
                            <Button x:Name="TaskPrimary" Style="{StaticResource PillButton}" Background="#FF0A84FF" Margin="6,0,0,0" Click="TaskPrimary_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Expanded: hover -->
                    <Grid x:Name="ExpandedView" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed"
                          Width="480" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0">
                        <StackPanel>

                            <!-- Home: the player (or the clock), and whatever is going on -->
                            <StackPanel x:Name="HomePanel">
                                <StackPanel x:Name="MediaPanel">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- The sleep timer: a moon, and the minutes left while it runs -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="8,0,0,0">
                                            <Button x:Name="SleepBtn" Style="{StaticResource NotchButton}" Width="30" Height="30" Click="Sleep_Click"
                                                    ToolTip="Sleep timer">
                                                <TextBlock x:Name="SleepIcon" Text="&#xE708;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                           Foreground="{StaticResource Faint}"/>
                                            </Button>
                                            <TextBlock x:Name="SleepText" FontSize="10" FontWeight="SemiBold" Foreground="#FFFF9F0A"
                                                       HorizontalAlignment="Center" Visibility="Collapsed"/>
                                        </StackPanel>
                                        <!-- Clicking the cover or the title brings the player to the front -->
                                        <Border x:Name="BigArt" Width="58" Height="58" CornerRadius="12" Background="{StaticResource ArtFallback}"
                                                Cursor="Hand" ToolTip="Open the player" MouseLeftButtonUp="Player_Click">
                                            <TextBlock x:Name="ArtPlaceholder" Text="&#xEC4F;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                                       Foreground="{StaticResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Background="Transparent"
                                                    Cursor="Hand" MouseLeftButtonUp="Player_Click">
                                            <TextBlock x:Name="TitleText" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="15"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="ArtistText" FontSize="13" Foreground="{StaticResource Dim}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                            <TextBlock x:Name="AppText" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
    
                                    <Grid x:Name="ProgressRow" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="42"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PosText" FontSize="11" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                                        <Border x:Name="ProgressHost" Grid.Column="1" Margin="4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="RemainText" Grid.Column="2" FontSize="11" Foreground="{StaticResource Dim}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
    
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                        <Button x:Name="ShuffleBtn" Style="{StaticResource NotchButton}" Width="34" Height="34" Margin="0,0,14,0"
                                                Click="Shuffle_Click" ToolTip="Shuffle">
                                            <TextBlock x:Name="ShuffleIcon" Text="&#xE8B1;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                                        </Button>
                                        <Button x:Name="PrevBtn" Style="{StaticResource NotchButton}" Width="42" Height="42" Click="Prev_Click">
                                            <Path Data="{StaticResource PrevGeo}" Style="{StaticResource IconPath}" Width="21" Height="15"/>
                                        </Button>
                                        <Button x:Name="PlayBtn" Style="{StaticResource NotchButton}" Width="46" Height="46" Margin="16,0" Click="Play_Click">
                                            <Path x:Name="PlayIcon" Data="{StaticResource PlayGeo}" Style="{StaticResource IconPath}" Width="18" Height="20"/>
                                        </Button>
                                        <Button x:Name="NextBtn" Style="{StaticResource NotchButton}" Width="42" Height="42" Click="Next_Click">
                                            <Path Data="{StaticResource NextGeo}" Style="{StaticResource IconPath}" Width="21" Height="15"/>
                                        </Button>
                                        <Button x:Name="RepeatBtn" Style="{StaticResource NotchButton}" Width="34" Height="34" Margin="14,0,0,0"
                                                Click="Repeat_Click" ToolTip="Repeat">
                                            <TextBlock x:Name="RepeatIcon" Text="&#xE8EE;" FontFamily="{StaticResource IconFont}" FontSize="14"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
    
                                <StackPanel x:Name="ClockPanel" Visibility="Collapsed" Margin="2,0,0,0">
                                    <TextBlock x:Name="ClockBig" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="40"
                                               FontWeight="Light" Margin="0,-6,0,0"/>
                                    <TextBlock x:Name="DateText" FontSize="13" Foreground="{StaticResource Dim}" Margin="1,0,0,0"/>
                                    <TextBlock Text="Nothing playing" FontSize="11" Foreground="{StaticResource Faint}" Margin="1,6,0,0"/>
                                </StackPanel>
    
                                <!-- Quiet hours: why messages don't pop out right now -->
                                <TextBlock x:Name="QuietNote" FontSize="11" Foreground="{StaticResource Dim}" Margin="2,12,0,-6" Visibility="Collapsed"/>
                                <StackPanel x:Name="MessageRows" Margin="0,14,0,0"/>
    
                                <!-- Downloads running right now -->
                                <Grid x:Name="DownloadRow" Margin="2,12,2,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#FF0A84FF" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DownloadRowName" Grid.Column="1" Margin="10,0,10,0" FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DownloadRowSize" Grid.Column="2" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                                </Grid>
    
                                <!-- A call: the app, how long, and a button that mutes the microphone -->
                                <Grid x:Name="CallRow" Margin="2,12,2,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="CallRowLogoHost" Width="28" Height="28" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="CallRowTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="CallRowTime" FontSize="12" Foreground="#FF30D158" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="CallMuteBtn" Grid.Column="2" Style="{StaticResource PillButton}" VerticalAlignment="Center" Click="CallMute_Click"/>
                                </Grid>
    
                                <!-- Apps using the microphone or the camera, and a button that mutes the microphone -->
                                <StackPanel x:Name="PrivacyRows" Margin="2,12,2,0" Visibility="Collapsed"/>
    
                                <!-- A running timer: what's left, pause and stop -->
                                <Grid x:Name="TimerRow" Margin="2,12,2,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#FFFF9F0A" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,10,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TimerRowText" FontSize="15" FontWeight="SemiBold" Foreground="#FFFF9F0A" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TimerRowLength" FontSize="12" Foreground="{StaticResource Dim}" Margin="10,1,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button x:Name="TimerPauseBtn" Style="{StaticResource NotchButton}" Width="30" Height="30" Click="TimerPause_Click">
                                            <TextBlock x:Name="TimerPauseIcon" Text="&#xE769;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                        </Button>
                                        <Button Style="{StaticResource NotchButton}" Width="30" Height="30" Margin="2,0,0,0" ToolTip="Stop the timer" Click="TimerStop_Click">
                                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="13"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
    
                                <!-- The shelf: files parked here, to drag out where they should go -->
                                <StackPanel x:Name="ShelfRow" Margin="2,12,2,0" Visibility="Collapsed">
                                    <Grid>
                                        <TextBlock x:Name="ShelfTitle" FontSize="11" Foreground="{StaticResource Dim}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Left" Background="Transparent" Cursor="SizeAll"
                                                   ToolTip="Drag to take everything off the shelf at once"
                                                   MouseLeftButtonDown="Shelf_MouseDown" MouseMove="Shelf_MouseMove"/>
                                        <Button HorizontalAlignment="Right" Style="{StaticResource NotchButton}" Width="24" Height="24"
                                                ToolTip="Clear the shelf (the files stay where they are)" Click="ShelfClear_Click">
                                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource Dim}"/>
                                        </Button>
                                    </Grid>
                                    <WrapPanel x:Name="ShelfItemsPanel" Margin="0,6,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- A tool from the tool bar, in place of home while it is open -->
                            <Grid x:Name="ToolPage" Visibility="Collapsed">
                                <!-- A short note that survives a restart -->
                                <StackPanel x:Name="NotesPage" Visibility="Collapsed">
                                    <TextBlock Text="Notes" FontSize="11" Foreground="{StaticResource Dim}" Margin="2,0,0,6"/>
                                    <Grid>
                                        <TextBox x:Name="NotesBox" Style="{StaticResource NotchTextBox}" AcceptsReturn="True" AcceptsTab="False"
                                                 TextWrapping="Wrap" MinHeight="96" MaxHeight="170" MaxLength="4000" TextChanged="NotesBox_TextChanged"/>
                                        <TextBlock x:Name="NotesPlaceholder" Text="Jot something down – it stays here, even after a restart"
                                                   FontSize="13" Foreground="{StaticResource Faint}" Margin="12,8,12,0" IsHitTestVisible="False"
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Reminders in plain words: "20 min laundry", "14:30 dentist" -->
                                <StackPanel x:Name="RemindersPage" Visibility="Collapsed">
                                    <TextBlock Text="Reminders" FontSize="11" Foreground="{StaticResource Dim}" Margin="2,0,0,6"/>
                                    <Grid>
                                        <TextBox x:Name="ReminderBox" Style="{StaticResource NotchTextBox}" MaxLength="200"
                                                 TextChanged="ReminderBox_TextChanged" KeyDown="ReminderBox_KeyDown"/>
                                        <TextBlock x:Name="ReminderPlaceholder" Text="20 min laundry · 14:30 dentist · tomorrow 9:00 call"
                                                   FontSize="13" Foreground="{StaticResource Faint}" Margin="12,8,12,0" IsHitTestVisible="False"/>
                                    </Grid>
                                    <TextBlock x:Name="ReminderHint" FontSize="11" Foreground="{StaticResource Dim}" Margin="4,6,0,10"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel x:Name="ReminderRows"/>
                                </StackPanel>

                                <!-- A quick sum: the result shows while you type; click it or press Enter to copy -->
                                <StackPanel x:Name="CalculatorPage" Visibility="Collapsed">
                                    <TextBlock Text="Calculator" FontSize="11" Foreground="{StaticResource Dim}" Margin="2,0,0,6"/>
                                    <Grid>
                                        <TextBox x:Name="CalcBox" Style="{StaticResource NotchTextBox}" MaxLength="300"
                                                 TextChanged="CalcBox_TextChanged" KeyDown="CalcBox_KeyDown"/>
                                        <TextBlock x:Name="CalcPlaceholder" Text="12,5 × 4 + 15%"
                                                   FontSize="13" Foreground="{StaticResource Faint}" Margin="12,8,12,0" IsHitTestVisible="False"/>
                                    </Grid>
                                    <Button Style="{StaticResource RowButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Margin="0,8,0,0" ToolTip="Copy the result" Click="CalcResult_Click">
                                        <TextBlock x:Name="CalcResult" FontSize="26" FontWeight="SemiBold" Margin="4,0,4,0" MinHeight="34"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Button>
                                    <TextBlock x:Name="CalcHint" FontSize="11" Foreground="{StaticResource Dim}" Margin="4,2,0,4"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- The last 20 things copied; a click puts one back. Passwords never show up here -->
                                <StackPanel x:Name="ClipboardPage" Visibility="Collapsed">
                                    <Grid Margin="2,0,0,6">
                                        <TextBlock Text="Clipboard" FontSize="11" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                                        <Button x:Name="ClipClearBtn" HorizontalAlignment="Right" Style="{StaticResource NotchButton}" Width="24" Height="24"
                                                ToolTip="Clear the list" Click="ClipClear_Click">
                                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource Dim}"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="ClipEmpty" Text="Copy a text or a picture: the last 20 show up here. Passwords never do."
                                               FontSize="13" Foreground="{StaticResource Faint}" TextWrapping="Wrap" Margin="2,4,2,8"/>
                                    <ScrollViewer MaxHeight="236" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                                        <StackPanel x:Name="ClipRows"/>
                                    </ScrollViewer>
                                    <TextBlock x:Name="ClipHint" FontSize="11" Foreground="{StaticResource Dim}" Margin="4,4,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>

                            <!-- Tools: each opens its page in place of home; click again to go back -->
                            <StackPanel x:Name="ToolBar" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                <Button x:Name="NotesToolBtn" Style="{StaticResource ToolButton}" ToolTip="Notes" Click="NotesTool_Click">
                                    <TextBlock Text="&#xE70B;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource Dim}"/>
                                </Button>
                                <Button x:Name="RemindersToolBtn" Style="{StaticResource ToolButton}" ToolTip="Reminders" Click="RemindersTool_Click">
                                    <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource Dim}"/>
                                </Button>
                                <Button x:Name="CalculatorToolBtn" Style="{StaticResource ToolButton}" ToolTip="Calculator" Click="CalculatorTool_Click">
                                    <TextBlock Text="&#xE8EF;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource Dim}"/>
                                </Button>
                                <Button x:Name="ClipboardToolBtn" Style="{StaticResource ToolButton}" ToolTip="Clipboard history" Click="ClipboardTool_Click">
                                    <TextBlock Text="&#xE77F;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource Dim}"/>
                                </Button>
                                <!-- Not a page: it closes the notch and picks a color from the screen -->
                                <Button x:Name="ColorPickerBtn" Style="{StaticResource ToolButton}" ToolTip="Pick a color from the screen (Esc cancels)" Click="ColorPicker_Click">
                                    <TextBlock Text="&#xEF3C;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource Dim}"/>
                                </Button>
                            </StackPanel>

                            <Border Height="1" Background="#1AFFFFFF" Margin="0,12,0,8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <WrapPanel x:Name="DevicesPanel" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Bluetooth on and off, and the paired headphones and speakers to connect -->
                                    <Button x:Name="BluetoothBtn" Style="{StaticResource NotchButton}" Width="30" Height="30" Margin="0,0,2,0"
                                            Visibility="Collapsed" Click="Bluetooth_Click">
                                        <TextBlock x:Name="BluetoothIcon" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   Foreground="{StaticResource Dim}" Text="&#xE702;"/>
                                    </Button>
                                    <!-- Where the sound goes: a list of the speakers and headphones to switch to -->
                                    <Button x:Name="OutputBtn" Style="{StaticResource NotchButton}" Width="30" Height="30" Margin="0,0,2,0"
                                            Visibility="Collapsed" Click="Output_Click">
                                        <TextBlock x:Name="OutputIcon" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   Foreground="{StaticResource Dim}" Text="&#xE7F5;"/>
                                    </Button>
                                    <Button x:Name="MuteBtn" Style="{StaticResource NotchButton}" Width="30" Height="30" Click="Mute_Click">
                                        <TextBlock x:Name="VolIcon" FontFamily="{StaticResource IconFont}" FontSize="14"
                                                   Foreground="{StaticResource Dim}" Text="&#xE995;"/>
                                    </Button>
                                    <Border x:Name="VolumeHost" Width="84" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                    <!-- Opens Claude, Gemini, ChatGPT or your own pick (right-click › AI button) -->
                                    <Button x:Name="AiBtn" Style="{StaticResource NotchButton}" Width="30" Height="30" Margin="6,0,0,0"
                                            Visibility="Collapsed" Click="Ai_Click">
                                        <Border x:Name="AiIconHost" Width="18" Height="18"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Orange while an app uses the microphone, green while one uses the camera: beside the notch, like a phone's -->
            <StackPanel x:Name="PrivacyDots" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,11,-28,0" IsHitTestVisible="False" Visibility="Collapsed">
                <Ellipse x:Name="MicrophoneDot" Width="7" Height="7" Fill="#FFFF9F0A" Visibility="Collapsed"/>
                <Ellipse x:Name="CameraDot" Width="7" Height="7" Fill="#FF30D158" Margin="4,0,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
